[Unit]
Description=fanout - VPN Gate exit fan-out gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The port is controlled by /var/lib/fanout/settings.json and can be changed
# from both the Web UI and the f menu. Do not add -web here or restarts would
# restore an old port value.
ExecStart=/usr/local/bin/fanout -dir /var/lib/fanout
Restart=on-failure
RestartSec=5
# Allow enough time to clean up network namespaces and OpenVPN child processes.
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
